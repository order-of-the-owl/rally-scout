# Local Docker: postgresql://rally_scout:rally_scout@localhost:5432/rally_scout
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Gemini API key from Google AI Studio
AI_API_KEY=
# Optional: defaults to Gemini's OpenAI-compatible endpoint.
# If time allows later, switch to a LiteLLM proxy for fallbacks and spend tracking: see commit fbcdc4e
AI_BASE_URL=
# Optional: default to gemini-3.6-flash and gemini-3.5-flash-lite
AI_MODEL_REPORT=
AI_MODEL_FAST=
# Optional: the Train page shows a notice when this is empty
YOUTUBE_API_KEY=
AI_RATE_LIMIT_PER_HOUR=20
# Optional: debug, info, warn or error. Defaults to info in production, debug otherwise
LOG_LEVEL=
