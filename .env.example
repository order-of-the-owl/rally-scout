# App (.env.local / Vercel)
# Local Docker: postgresql://rally_scout:rally_scout@localhost:5432/rally_scout
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# e.g. http://localhost:4000 locally, the proxy's URL in production
LITELLM_BASE_URL=
# LiteLLM master key or a virtual key
LITELLM_API_KEY=
AI_MODEL_REPORT=smart
AI_MODEL_FAST=fast
# Optional: the Train page shows a notice when this is empty
YOUTUBE_API_KEY=
AI_RATE_LIMIT_PER_HOUR=20
# Optional: debug, info, warn or error. Defaults to info in production, debug otherwise
LOG_LEVEL=

# LiteLLM proxy (its own host)
LITELLM_MASTER_KEY=
# Key(s) for whichever provider(s) litellm/config.yaml uses
PROVIDER_API_KEY=
